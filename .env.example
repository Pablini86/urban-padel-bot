# WhatsApp (Meta for Developers → WhatsApp → API Setup)
WHATSAPP_TOKEN=
PHONE_NUMBER_ID=
WEBHOOK_VERIFY_TOKEN=urban_padel_2025

# Plantillas de Meta (WhatsApp Manager → cuenta de WhatsApp Business)
# WABA_ID: ID de la cuenta de WhatsApp Business (distinto del PHONE_NUMBER_ID)
# WHATSAPP_APP_ID: ID de la app de Meta for Developers (necesario solo para subir imágenes de header)
# WHATSAPP_MGMT_TOKEN: token con permiso whatsapp_business_management
WABA_ID=
WHATSAPP_APP_ID=
WHATSAPP_MGMT_TOKEN=

# IA (console.anthropic.com)
ANTHROPIC_API_KEY=

# Playtomic (thirdparty.playtomic.io — credenciales de partner)
PLAYTOMIC_CLIENT_ID=
PLAYTOMIC_CLIENT_SECRET=
PLAYTOMIC_TENANT_ID=

# Base de datos (Railway la genera automáticamente al agregar un plugin de Postgres)
DATABASE_URL=

# Dashboard de conversaciones — mismo password para las 3 cuentas
DASHBOARD_PASSWORD=

# Opcional, Railway lo define solo
PORT=3000
